# Choreo Configuration for Local Testing
# Copy this file to .env.local and fill in actual values
# NEVER commit the .env.local file to git!

# Choreo API Base URL
# Production: https://apis.choreo.dev/devops/1.0.0
# Staging: https://apis.st.choreo.dev/devops/1.0.0
# Preview: https://apis.preview-dv.choreo.dev/devops/1.0.0
BASE_URL=https://apis.choreo.dev/devops/1.0.0

# Choreo API Access Token (get from Choreo console or CLI)
ACCESS_TOKEN=your_access_token_here

# Organization UUID (from Choreo console URL)
ORG_UUID=your_org_uuid_here

# Project ID (from Choreo console)
PROJECT_ID=your_project_id_here

# Component ID (from Choreo console)
COMPONENT_ID=your_component_id_here

# Environment ID (from Choreo console)
ENV_ID=your_env_id_here

# Application Environment ID (from Choreo console)
APP_ENV_ID=your_app_env_id_here
